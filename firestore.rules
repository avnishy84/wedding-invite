rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rsvps/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['name','guests','events','message','attending','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.guests is int && request.resource.data.guests >= 1 && request.resource.data.guests <= 10
        && request.resource.data.events is list
        && request.resource.data.attending is bool
        && (!('message' in request.resource.data) || request.resource.data.message.size() <= 300);
    }
  }
}
